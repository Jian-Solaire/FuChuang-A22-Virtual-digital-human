APP_ENV=dev
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=60
DEEPSEEK_MOCK_ONLY=0

MILVUS_ENABLED=1
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_SECTION_COLLECTION=dh_sections
MILVUS_CHUNK_COLLECTION=dh_chunks
MILVUS_MEMORY_COLLECTION=dh_memory
MILVUS_SECURE=0

PAGEINDEX_ENABLED=1
PAGEINDEX_CACHE_DIR=H:/Digital_human/backend/.runtime/pageindex_cache
APP_DATA_DIR=H:/Digital_human/backend/.runtime
KNOWLEDGE_DIR=H:/Digital_human/data/knowledge
DEFAULT_NAMESPACE=default

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_ENABLE_DENSE=1
EMBEDDING_ENABLE_SPARSE=1
EMBEDDING_BATCH_SIZE=8
MODEL_CACHE_DIR=H:/Digital_human/models/bge-m3

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=1
RERANKER_TOP_N=20
RERANKER_CACHE_DIR=H:/Digital_human/models
